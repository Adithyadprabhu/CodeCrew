// ─────────────────────────────────────────────────────────────
//  firestore.rules
//  Security rules for CycleX — cyclex-2f234
//  Deploy via: firebase deploy --only firestore:rules
// ─────────────────────────────────────────────────────────────

rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helper: is the caller signed in? ──────────────────────
    function isAuthed() {
      return request.auth != null;
    }

    // ── Helper: is the caller the owner of this document? ─────
    function isOwner(uid) {
      return isAuthed() && request.auth.uid == uid;
    }

    // ═══════════════════════════════════════════════════════════
    //  USERS  /users/{uid}
    //  • Any authenticated user can read any profile (for contact)
    //  • Only the owner may write their own document
    // ═══════════════════════════════════════════════════════════
    match /users/{uid} {
      allow read:   if isAuthed();
      allow create: if isOwner(uid);
      allow update: if isOwner(uid);
      allow delete: if isOwner(uid);
    }

    // ═══════════════════════════════════════════════════════════
    //  LISTINGS  /listings/{listingId}
    //  • Any authenticated user can read listings (marketplace)
    //  • Only the seller (resource.data.sellerId == uid) may
    //    create, update, or delete their own listings
    // ═══════════════════════════════════════════════════════════
    match /listings/{listingId} {
      allow read:   if isAuthed();
      allow create: if isAuthed()
                    && request.resource.data.sellerId == request.auth.uid;
      allow update: if isAuthed()
                    && resource.data.sellerId == request.auth.uid;
      allow delete: if isAuthed()
                    && resource.data.sellerId == request.auth.uid;
    }

    // ═══════════════════════════════════════════════════════════
    //  ORDERS  /orders/{orderId}
    //  • Buyer may create an order for themselves
    //  • Buyer OR the associated seller may read / update status
    //  • No one may delete orders (audit trail)
    // ═══════════════════════════════════════════════════════════
    match /orders/{orderId} {
      allow read:   if isAuthed()
                    && (resource.data.buyerId == request.auth.uid
                        || isSellerOfListing(resource.data.listingId));

      allow create: if isAuthed()
                    && request.resource.data.buyerId == request.auth.uid;

      allow update: if isAuthed()
                    && (resource.data.buyerId == request.auth.uid
                        || isSellerOfListing(resource.data.listingId));

      allow delete: if isAuthed()
                    && isSellerOfListing(resource.data.listingId);
    }

    // ═══════════════════════════════════════════════════════════
    //  NOTIFICATIONS  /notifications/{notificationId}
    //  • Only the target user (userId) may read, update, or delete
    //  • Any authenticated user may create (server sends notifs)
    // ═══════════════════════════════════════════════════════════
    match /notifications/{notificationId} {
      allow read:   if isAuthed()
                    && resource.data.userId == request.auth.uid;
      allow create: if isAuthed();
      allow update: if isAuthed()
                    && resource.data.userId == request.auth.uid;
      allow delete: if isAuthed()
                    && resource.data.userId == request.auth.uid;
    }

    // ── Helper: check if the caller is the seller of a listing ─
    // NOTE: Firestore rules cannot do async reads, so this check
    // is best enforced in JS services + enforced via create rules.
    function isSellerOfListing(listingId) {
      return get(/databases/$(database)/documents/listings/$(listingId))
               .data.sellerId == request.auth.uid;
    }
  }
}
